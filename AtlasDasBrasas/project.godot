; Atlas das Brasas • Godot 4.3+
config_version=5

[application]
config/name="Atlas das Brasas"
config/description="Um RPG de fantasia sobre as seis margens de um rio esquecido."
run/main_scene="res://cenas/Atlas.tscn"
config/icon="res://personagens/s0.png"

[autoload]
Saga="*res://scripts/saga.gd"

[display]
window/size/viewport_width=960
window/size/viewport_height=540
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/canvas_textures/default_texture_filter=0
environment/defaults/default_clear_color=Color(0.05,0.09,0.11,1)

[audio]
driver/enable_input=false
